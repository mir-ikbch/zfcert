{
  "Proposition alias": {
    "prefix": "alias",
    "body": "alias ${1:is_empty} ${2:x} := ${3:forall y, not (y in x)}.",
    "description": "Give a transparent alias to a proposition, optionally with arguments"
  },
  "Choose existential witness": {
    "prefix": "Choose",
    "body": "Choose ${1:empty} ${2:Hempty} from ${3:empty_set}.",
    "description": "Declare a global witness constant and its certified fact"
  },
  "Skolem function": {
    "prefix": "Skolem",
    "body": "Skolem ${1:pair} ${2:Hpair} from ${3:pairing}.",
    "description": "Declare a certified Skolem function from a universal-existential fact"
  },
  "Primitive rule proof": {
    "prefix": "ruleproof",
    "body": [
      "theorem ${1:rule_identity} : forall x, x = x.",
      "rule all_intro x.",
      "rule equal_refl.",
      "qed."
    ],
    "description": "Create a proof using only primitive natural-deduction rules"
  },
  "Cut rule": {
    "prefix": "rule cut",
    "body": "rule cut ${1:H} : ${2:P}.",
    "description": "Apply the primitive Cut rule"
  },
  "Equality elimination rule": {
    "prefix": "rule equal_elim",
    "body": "rule equal_elim ${1:s} ${2:t} ${3:x} : ${4:P}.",
    "description": "Apply the primitive equality-elimination rule"
  },
  "Theorem": {
    "prefix": "theorem",
    "body": [
      "theorem ${1:name} : ${2:forall x, x = x}.",
      "${3:intro x}.",
      "${4:refl}.",
      "qed."
    ],
    "description": "Create a ZFCert theorem"
  },
  "Specialize universal fact": {
    "prefix": "specialize",
    "body": "specialize ${1:H} ${2:a} as ${3:H_a}.",
    "description": "Instantiate a universally quantified fact"
  },
  "Obtain existential witness": {
    "prefix": "obtain",
    "body": "obtain ${1:x} ${2:Hx} from ${3:H}.",
    "description": "Specialize and eliminate an existential fact"
  },
  "Separation instance": {
    "prefix": "separation",
    "body": "separation ${1:S} ${2:a} ${3:x} : ${4:not (x in x)}.",
    "description": "Create a separation schema instance"
  },
  "Replacement instance": {
    "prefix": "replacement",
    "body": "replacement ${1:R} ${2:a} ${3:x} ${4:y} : ${5:y = x}.",
    "description": "Create a replacement schema instance"
  }
}
