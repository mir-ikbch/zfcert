intro H.
specialize Hchar x as Hm.
apply -> Hm in H as Hcases.
cases Hcases Hcell_rest_b Hcell_b.
apply Hneq_a.
exact Hcell_rest_b.
apply Hneq_b.
exact Hcell_b.
qed.
