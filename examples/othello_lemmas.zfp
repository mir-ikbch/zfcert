rule equal_elim move cell(two,three) z : after_place stones_ecea stones_ieca z Bn Wn.
exact Hchoices_right.
exact Hafter.
rule cut Hsame : Bn = stones_eoea and Wn = stones_iaca.
specialize after_place_unique stones_ecea stones_ieca cell(two,three) Bn Wn stones_eoea stones_iaca as Hunique.
apply Hunique.
exact Hground.
exact after_place_ecea_ieca_l.
cases Hsame Hsame_b Hsame_w.
right.
rewrite Htarget.
rewrite Hsame_b.
rewrite Hsame_w.
refl.
qed.
theorem not_terminal_ia : not (terminal stones_cea stones_eca).
intro Hterminal.
specialize nonterminal_from_move stones_cea stones_eca as Hnt.
apply Hnt.
use cell(zero,one).
exact can_place_cea_eca_b.
exact Hterminal.
qed.
theorem successors_ia : forall t, step certificate_state_ia t -> (t = certificate_state_dh or t = certificate_state_dp or t = certificate_state_hh or t = certificate_state_hp).
intros t Hstep.
specialize step_from_black stones_cea stones_eca t as Hfrom.
apply Hfrom in Hstep as Hex.
obtain Bn Hbn from Hex.
obtain Wn Hwn from Hbn.
cases Hwn Hprefix Hturn.
cases Hprefix Htarget Hvalid.
rule cut Hhas : has_move stones_cea stones_eca.
use cell(zero,one).
exact can_place_cea_eca_b.
rule cut Hplacement : exists move, after_place stones_cea stones_eca move Bn Wn.
specialize turn_step_with_move stones_cea stones_eca Bn Wn as Hwith.
apply Hwith.
exact Hhas.
exact Hturn.
obtain move Hafter from Hplacement.
cases Hafter Hfirst Hother.
cases Hfirst Hcan Hown.
specialize legal_moves_cea_eca move as Hlist.
apply Hlist in Hcan as Hchoices.
cases Hchoices Hchoices_left Hchoices_right.
cases Hchoices_left Hchoices_left_left Hchoices_left_right.
cases Hchoices_left_left Hchoices_left_left_left Hchoices_left_left_right.
rule cut Hground : after_place stones_cea stones_eca cell(zero,one) Bn Wn.
rule equal_elim move cell(zero,one) z : after_place stones_cea stones_eca z Bn Wn.
exact Hchoices_left_left_left.
exact Hafter.
rule cut Hsame : Bn = stones_cgc and Wn = stones_eaa.
specialize after_place_unique stones_cea stones_eca cell(zero,one) Bn Wn stones_cgc stones_eaa as Hunique.
apply Hunique.
exact Hground.
exact after_place_cea_eca_b.
cases Hsame Hsame_b Hsame_w.
left.
left.
left.
rewrite Htarget.
rewrite Hsame_b.
rewrite Hsame_w.
refl.
rule cut Hground : after_place stones_cea stones_eca cell(one,zero) Bn Wn.
rule equal_elim move cell(one,zero) z : after_place stones_cea stones_eca z Bn Wn.
exact Hchoices_left_left_right.
exact Hafter.
rule cut Hsame : Bn = stones_cha and Wn = stones_eaa.
specialize after_place_unique stones_cea stones_eca cell(one,zero) Bn Wn stones_cha stones_eaa as Hunique.
apply Hunique.
exact Hground.
exact after_place_cea_eca_e.
cases Hsame Hsame_b Hsame_w.
left.
left.
right.
rewrite Htarget.
rewrite Hsame_b.
rewrite Hsame_w.
refl.
rule cut Hground : after_place stones_cea stones_eca cell(two,three) Bn Wn.
rule equal_elim move cell(two,three) z : after_place stones_cea stones_eca z Bn Wn.
exact Hchoices_left_right.
exact Hafter.
rule cut Hsame : Bn = stones_oea and Wn = stones_ca.
specialize after_place_unique stones_cea stones_eca cell(two,three) Bn Wn stones_oea stones_ca as Hunique.
apply Hunique.
exact Hground.
exact after_place_cea_eca_l.
cases Hsame Hsame_b Hsame_w.
left.
right.
rewrite Htarget.
rewrite Hsame_b.
rewrite Hsame_w.
refl.
rule cut Hground : after_place stones_cea stones_eca cell(three,two) Bn Wn.
rule equal_elim move cell(three,two) z : after_place stones_cea stones_eca z Bn Wn.
exact Hchoices_right.
exact Hafter.
rule cut Hsame : Bn = stones_egea and Wn = stones_ca.
specialize after_place_unique stones_cea stones_eca cell(three,two) Bn Wn stones_egea stones_ca as Hunique.
apply Hunique.
exact Hground.
exact after_place_cea_eca_o.
cases Hsame Hsame_b Hsame_w.
right.
rewrite Htarget.
rewrite Hsame_b.
rewrite Hsame_w.
refl.
qed.

