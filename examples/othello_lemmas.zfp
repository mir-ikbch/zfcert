(* othello4.zfp の定義に続けて読み込む、補題と有限な証明書。 *)

theorem finite_succ_members : forall a x,
  x in succ(a) <-> (x in a or x = a).
intros a x.
specialize Hcup a singleton(a) x as Hcup_a.
specialize Hsingleton a x as Hsingle_a.
resolution.
qed.

theorem finite_one_members : forall x, x in one <-> x = zero.
intro x.
specialize finite_succ_members zero x as Hone.
specialize Hempty x as Hemp.
resolution.
qed.

theorem finite_two_members : forall x, x in two <-> (x = zero or x = one).
intro x.
specialize finite_succ_members one x as Htwo.
specialize finite_one_members x as Hone.
resolution.
qed.

theorem finite_three_members : forall x, x in three <-> (x = zero or x = one or x = two).
intro x.
specialize finite_succ_members two x as Hthree.
specialize finite_two_members x as Htwo.
resolution.
qed.

theorem finite_four_members : forall x,
  x in four <-> (x = zero or x = one or x = two or x = three).
intro x.
specialize finite_succ_members three x as Hfour.
specialize finite_three_members x as Hthree.
split.
intro Hx.
resolution.
intro Hx.
resolution.
qed.

theorem finite_not_self_mem : forall a, not (a in a).
intros a Hself.
specialize no_two_cycle a a as Hcycle.
apply Hcycle.
exact Hself.
exact Hself.
qed.
theorem finite_mem_implies_neq : forall a b, a in b -> not (a = b).
intros a b Hab Heq.
specialize eq_subst_mem_left a b b as Hsub.
rule cut Hself : b in b.
apply Hsub.
exact Heq.
exact Hab.
specialize finite_not_self_mem b as Hnot.
apply Hnot.
exact Hself.
qed.
theorem finite_neq_zero_one : not (zero = one).
intro Heq.
specialize finite_mem_implies_neq zero one as Hneq.
apply Hneq.
specialize finite_one_members zero as Hmembers.
apply <- Hmembers.
refl.
exact Heq.
qed.
theorem finite_neq_one_zero : not (one = zero).
intro Heq.
specialize eq_sym one zero as Hsym.
apply Hsym in Heq as Hback.
apply finite_neq_zero_one.
exact Hback.
qed.
theorem finite_neq_zero_two : not (zero = two).
intro Heq.
specialize finite_mem_implies_neq zero two as Hneq.
apply Hneq.
specialize finite_two_members zero as Hmembers.
apply <- Hmembers.
left.
refl.
exact Heq.
qed.
theorem finite_neq_two_zero : not (two = zero).
intro Heq.
specialize eq_sym two zero as Hsym.
apply Hsym in Heq as Hback.
apply finite_neq_zero_two.
exact Hback.
qed.
theorem finite_neq_zero_three : not (zero = three).
intro Heq.
specialize finite_mem_implies_neq zero three as Hneq.
apply Hneq.
specialize finite_three_members zero as Hmembers.
apply <- Hmembers.
left.
left.
refl.
exact Heq.
qed.
theorem finite_neq_three_zero : not (three = zero).
intro Heq.
specialize eq_sym three zero as Hsym.
apply Hsym in Heq as Hback.
apply finite_neq_zero_three.
exact Hback.
qed.


theorem finite_neq_one_two : not (one = two).
intro Heq.
specialize finite_mem_implies_neq one two as Hneq.
apply Hneq.
specialize finite_two_members one as Hmembers.
apply <- Hmembers.
right.
refl.
exact Heq.
qed.
theorem finite_neq_two_one : not (two = one).
intro Heq.
specialize eq_sym two one as Hsym.
apply Hsym in Heq as Hback.
apply finite_neq_one_two.
exact Hback.
qed.
theorem finite_neq_one_three : not (one = three).
intro Heq.
specialize finite_mem_implies_neq one three as Hneq.
apply Hneq.
specialize finite_three_members one as Hmembers.
apply <- Hmembers.
left.
right.
refl.
exact Heq.
qed.
theorem finite_neq_three_one : not (three = one).
intro Heq.
specialize eq_sym three one as Hsym.
apply Hsym in Heq as Hback.
apply finite_neq_one_three.
exact Hback.
qed.


theorem finite_neq_two_three : not (two = three).
intro Heq.
specialize finite_mem_implies_neq two three as Hneq.
apply Hneq.
specialize finite_three_members two as Hmembers.
apply <- Hmembers.
right.
refl.
exact Heq.
qed.
theorem finite_neq_three_two : not (three = two).
intro Heq.
specialize eq_sym three two as Hsym.
apply Hsym in Heq as Hback.
apply finite_neq_two_three.
exact Hback.
qed.


theorem finite_cell_in_board : forall r c, r in four -> c in four -> cell(r,c) in board.
intros r c Hr Hc.
specialize Hprod four four cell(r,c) as Hprod_rc.
apply <- Hprod_rc.
use r.
use c.
split.
split.
exact Hr.
exact Hc.
refl.
qed.
theorem finite_board_members : forall p, p in board -> (p = cell(zero,zero) or p = cell(zero,one) or p = cell(zero,two) or p = cell(zero,three) or p = cell(one,zero) or p = cell(one,one) or p = cell(one,two) or p = cell(one,three) or p = cell(two,zero) or p = cell(two,one) or p = cell(two,two) or p = cell(two,three) or p = cell(three,zero) or p = cell(three,one) or p = cell(three,two) or p = cell(three,three)).
intros p Hp.
specialize Hprod four four p as Hboard.
apply -> Hboard in Hp as Hcoords.
obtain r Hr from Hcoords.
obtain c Hrc from Hr.
cases Hrc Hmembers Heq.
cases Hmembers Hr_member Hc_member.
specialize finite_four_members r as Hr_four.
apply -> Hr_four in Hr_member as Hrows.
specialize finite_four_members c as Hc_four.
apply -> Hc_four in Hc_member as Hcols.
cases Hrows Hrow_prefix_3 Hrow_3.
cases Hrow_prefix_3 Hrow_prefix_2 Hrow_2.
cases Hrow_prefix_2 Hrow_prefix_1 Hrow_1.
cases Hcols Hcol_0_prefix_3 Hcol_0_3.
cases Hcol_0_prefix_3 Hcol_0_prefix_2 Hcol_0_2.
cases Hcol_0_prefix_2 Hcol_0_prefix_1 Hcol_0_1.
