theorem finite_nonmember_one : forall S x p_a,
  (forall y, y in S <-> (y = p_a)) ->
  not (x = p_a) -> not (x in S).
intros S x p_a Hchar Hneq_a.
intro H.
specialize Hchar x as Hm.
apply -> Hm in H as Hcases.
apply Hneq_a.
exact Hcases.
qed.
