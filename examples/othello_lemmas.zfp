(* 局面を表す有限集合と、その所属・妥当性の証明 *)

(* 有限列挙の結合と非所属判定を共通化する補題。具体的な所属補題の主張は維持する。 *)

theorem finite_union_members_one_two : forall A B p_a p_b p_c x,
  (x in A <-> (x = p_a)) ->
  (x in B <-> (x = p_b or x = p_c)) ->
  (x in cup(A,B) <->  (x = p_a or x = p_b or x = p_c)).
intros A B p_a p_b p_c x Ha Hb.
specialize Hcup A B x as Hc.
split.
intro H.
apply -> Hc in H as Hunion.
cases Hunion Hleft Hright.
apply -> Ha in Hleft as Hcases.
left.
left.
exact Hcases.
apply -> Hb in Hright as Hcases.
cases Hcases Hitem_rest_b Hitem_b.
left.
right.
exact Hitem_rest_b.
right.
exact Hitem_b.
intro H.
cases H Hitem_rest_c Hitem_c.
cases Hitem_rest_c Hitem_rest_b Hitem_b.
apply <- Hc.
left.
apply <- Ha.
exact Hitem_rest_b.
apply <- Hc.
right.
apply <- Hb.
left.
exact Hitem_b.
apply <- Hc.
right.
apply <- Hb.
right.
exact Hitem_c.
qed.
theorem finite_union_members_two_two : forall A B p_a p_b p_c p_d x,
  (x in A <-> (x = p_a or x = p_b)) ->
  (x in B <-> (x = p_c or x = p_d)) ->
  (x in cup(A,B) <->  (x = p_a or x = p_b or x = p_c or x = p_d)).
intros A B p_a p_b p_c p_d x Ha Hb.
specialize Hcup A B x as Hc.
split.
intro H.
apply -> Hc in H as Hunion.
cases Hunion Hleft Hright.
apply -> Ha in Hleft as Hcases.
cases Hcases Hitem_rest_b Hitem_b.
left.
left.
left.
exact Hitem_rest_b.
left.
left.
right.
exact Hitem_b.
apply -> Hb in Hright as Hcases.
cases Hcases Hitem_rest_b Hitem_b.
left.
right.
exact Hitem_rest_b.
right.
exact Hitem_b.
intro H.
cases H Hitem_rest_d Hitem_d.
cases Hitem_rest_d Hitem_rest_c Hitem_c.
cases Hitem_rest_c Hitem_rest_b Hitem_b.
apply <- Hc.
left.
apply <- Ha.
left.
exact Hitem_rest_b.
apply <- Hc.
left.
apply <- Ha.
right.
exact Hitem_b.
apply <- Hc.
right.
apply <- Hb.
left.
exact Hitem_c.
apply <- Hc.
right.
apply <- Hb.
right.
exact Hitem_d.
qed.
