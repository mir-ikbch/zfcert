(* 合法な着手は盤面の妥当性を保存する。 *)

theorem flips_implies_other : forall own other move x,
  flips own other move x -> x in other.
intros own other move x Hflip.
obtain dr Hdr from Hflip.
obtain dc Hdc from Hdr.
obtain a Ha from Hdc.
obtain b Hb from Ha.
cases Hb Hprefix Hbranches.
cases Hprefix Hdirection Haother.
cases Hbranches Hsingle Hdouble.
  cases Hsingle Hstepown Hxa.
  rewrite Hxa.
  exact Haother.
  obtain z Hz from Hdouble.
  cases Hz Hdoubleprefix Hchoice.
  cases Hdoubleprefix Hprefixnext Hzinown.
  cases Hprefixnext Hprefixfirst Hdirectionnext.
  cases Hprefixfirst Hdirectionfirst Hbother.
  cases Hchoice Hxa Hxb.
    rewrite Hxa.
    exact Haother.
    rewrite Hxb.
    exact Hbother.
qed.

theorem valid_symmetry : forall own other,
  valid own other -> valid other own.
intros own other Hvalid.
cases Hvalid Hsubsets Hdisjoint.
cases Hsubsets Hown Hother.
split.
  split.
    exact Hother.
    exact Hown.
  intros x Hboth.
  cases Hboth Hxother Hxown.
  specialize Hdisjoint x as Hnotboth.
  apply Hnotboth.
  split.
    exact Hxown.
    exact Hxother.
qed.

theorem placement_preserves_valid : forall own other move own_next other_next,
  valid own other -> after_place own other move own_next other_next ->
  valid own_next other_next.
intros own other move own_next other_next Hvalid Hafter.
cases Hvalid Hsubsets Hdisjoint.
cases Hsubsets Hownsubset Hothersubset.
cases Hafter Hplaceown Hotherchar.
cases Hplaceown Hcanplace Hownchar.
cases Hcanplace Hcanprefix Hexistsflip.
cases Hcanprefix Hcanfirst Hmnotother.
cases Hcanfirst Hmoveboard Hmnotown.
split.
  split.
    intros x Hx.
    specialize Hownchar x as Hchar.
    apply -> Hchar in Hx as Hchoices.
    cases Hchoices Holdormove Hflip.
      cases Holdormove Hold Hmove.
        apply Hownsubset.
        exact Hold.
        rewrite Hmove.
        exact Hmoveboard.
      apply Hothersubset.
      specialize flips_implies_other own other move x as Hother.
      apply Hother.
      exact Hflip.
    intros x Hx.
    specialize Hotherchar x as Hchar.
    apply -> Hchar in Hx as Hremaining.
    cases Hremaining Hxother Hnotflip.
    apply Hothersubset.
    exact Hxother.
  intros x Hboth.
  cases Hboth Hxownnext Hxothernext.
  specialize Hownchar x as Hownatx.
  specialize Hotherchar x as Hotheratx.
  apply -> Hownatx in Hxownnext as Hchoices.
  apply -> Hotheratx in Hxothernext as Hremaining.
  cases Hremaining Hxother Hnotflip.
  cases Hchoices Holdormove Hflip.
    cases Holdormove Hold Hmove.
      specialize Hdisjoint x as Hnotboth.
      apply Hnotboth.
      split.
        exact Hold.
        exact Hxother.
      apply Hmnotother.
      rule equal_elim x move z : z in other.
        exact Hmove.
        exact Hxother.
    apply Hnotflip.
    exact Hflip.
qed.

