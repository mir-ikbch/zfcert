theorem mask_identity_choice : forall x, exists y, y = x.
intro x.
use x.
refl.
qed.
choose stones_baai eq_stones_baai from mask_identity_choice pair(cell(zero,three),cell(three,zero)).
theorem members_baai : forall x, x in stones_baai <-> (x = cell(zero,three) or x = cell(three,zero)).
intro x.
rewrite eq_stones_baai.
specialize Hpair cell(zero,three) cell(three,zero) x as Hm.
exact Hm.
qed.
