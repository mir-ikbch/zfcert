cases Hwn Hprefix Hturn.
cases Hprefix Htarget Hvalid.
rule cut Hhas : has_move stones_biei stones_ghdh.
use cell(three,three).
exact can_place_biei_ghdh_p.
rule cut Hplacement : exists move, after_place stones_biei stones_ghdh move Bn Wn.
specialize turn_step_with_move stones_biei stones_ghdh Bn Wn as Hwith.
apply Hwith.
exact Hhas.
exact Hturn.
obtain move Hafter from Hplacement.
cases Hafter Hfirst Hother.
cases Hfirst Hcan Hown.
specialize legal_moves_biei_ghdh move as Hlist.
apply Hlist in Hcan as Hchoices.
rule cut Hground : after_place stones_biei stones_ghdh cell(three,three) Bn Wn.
rule equal_elim move cell(three,three) z : after_place stones_biei stones_ghdh z Bn Wn.
exact Hchoices.
exact Hafter.
rule cut Hsame : Bn = stones_piei and Wn = stones_hdh.
specialize after_place_unique stones_biei stones_ghdh cell(three,three) Bn Wn stones_piei stones_hdh as Hunique.
apply Hunique.
exact Hground.
exact after_place_biei_ghdh_p.
cases Hsame Hsame_b Hsame_w.
rewrite Htarget.
rewrite Hsame_b.
rewrite Hsame_w.
refl.
