theorem black_pass_successor : forall B W t,
  not (has_move B W) -> step state(B,W,black) t -> t = state(B,W,white).
intros B W t Hnone Hstep.
specialize step_from_black B W t as Hfrom.
apply Hfrom in Hstep as Hex.
obtain Bn Hbn from Hex.
obtain Wn Hwn from Hbn.
cases Hwn Hprefix Hturn.
cases Hprefix Htarget Hvalid.
cases Hturn Hplace Hpass.
obtain move Hafter from Hplace.
cases Hafter Hfirst Hother.
cases Hfirst Hcan Hown.
rule falsum_elim.
apply Hnone.
use move.
exact Hcan.
cases Hpass Hpass_prefix Hsame_w.
cases Hpass_prefix Hpass_flags Hsame_b.
rewrite Htarget.
rewrite Hsame_b.
rewrite Hsame_w.
refl.
qed.
