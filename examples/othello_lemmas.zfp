(* 黒の全合法手、および着手不能の検証 *)

(* 合法手の有限な表。各マスの所属、反転不能、または候補だけを個別に与える。 *)

theorem move_table_blocked : forall own other move square,
  move = square ->
  (square in own or square in other or (forall x, not (flips own other square x))) ->
  not (can_place own other move).
intros own other move square Heq Hblocked Hcan.
cases Hcan Hprefix Hflips.
cases Hprefix Hboard_own Hnot_other.
cases Hboard_own Hboard Hnot_own.
cases Hblocked Hoccupied Hnone.
cases Hoccupied Hown Hother.
rule falsum_elim.
apply Hnot_own.
rule equal_elim square move z : z in own.
specialize eq_sym move square as Hsym.
apply Hsym.
exact Heq.
exact Hown.
rule falsum_elim.
apply Hnot_other.
rule equal_elim square move z : z in other.
specialize eq_sym move square as Hsym.
apply Hsym.
exact Heq.
exact Hother.
rule falsum_elim.
obtain x Hflip from Hflips.
specialize Hnone x as Hnot.
apply Hnot.
rule equal_elim move square z : flips own other z x.
exact Heq.
exact Hflip.
qed.

theorem move_table_branch_one : forall own other move square candidate_a,
  move = square -> can_place own other move ->
  (square in own or square in other or (forall x, not (flips own other square x)) or square = candidate_a) -> move = candidate_a.
intros own other move square candidate_a Heq Hcan Hchoice.
cases Hchoice Hblocked Hallowed.
cases Hcan Hprefix Hflips.
cases Hprefix Hboard_own Hnot_other.
cases Hboard_own Hboard Hnot_own.
cases Hblocked Hoccupied Hnone.
cases Hoccupied Hown Hother.
rule falsum_elim.
apply Hnot_own.
rule equal_elim square move z : z in own.
specialize eq_sym move square as Hsym.
apply Hsym.
exact Heq.
exact Hown.
rule falsum_elim.
apply Hnot_other.
rule equal_elim square move z : z in other.
specialize eq_sym move square as Hsym.
apply Hsym.
exact Heq.
exact Hother.
rule falsum_elim.
obtain x Hflip from Hflips.
specialize Hnone x as Hnot.
apply Hnot.
rule equal_elim move square z : flips own other z x.
exact Heq.
exact Hflip.
rule equal_elim square move z : z = candidate_a.
specialize eq_sym move square as Hsym.
apply Hsym.
exact Heq.
exact Hallowed.
qed.

theorem legal_moves_table_one : forall own other candidate_a move,
  (cell(zero,zero) in own or cell(zero,zero) in other or (forall x, not (flips own other cell(zero,zero) x)) or cell(zero,zero) = candidate_a) ->
  (cell(zero,one) in own or cell(zero,one) in other or (forall x, not (flips own other cell(zero,one) x)) or cell(zero,one) = candidate_a) ->
  (cell(zero,two) in own or cell(zero,two) in other or (forall x, not (flips own other cell(zero,two) x)) or cell(zero,two) = candidate_a) ->
  (cell(zero,three) in own or cell(zero,three) in other or (forall x, not (flips own other cell(zero,three) x)) or cell(zero,three) = candidate_a) ->
  (cell(one,zero) in own or cell(one,zero) in other or (forall x, not (flips own other cell(one,zero) x)) or cell(one,zero) = candidate_a) ->
  (cell(one,one) in own or cell(one,one) in other or (forall x, not (flips own other cell(one,one) x)) or cell(one,one) = candidate_a) ->
  (cell(one,two) in own or cell(one,two) in other or (forall x, not (flips own other cell(one,two) x)) or cell(one,two) = candidate_a) ->
  (cell(one,three) in own or cell(one,three) in other or (forall x, not (flips own other cell(one,three) x)) or cell(one,three) = candidate_a) ->
  (cell(two,zero) in own or cell(two,zero) in other or (forall x, not (flips own other cell(two,zero) x)) or cell(two,zero) = candidate_a) ->
  (cell(two,one) in own or cell(two,one) in other or (forall x, not (flips own other cell(two,one) x)) or cell(two,one) = candidate_a) ->
  (cell(two,two) in own or cell(two,two) in other or (forall x, not (flips own other cell(two,two) x)) or cell(two,two) = candidate_a) ->
  (cell(two,three) in own or cell(two,three) in other or (forall x, not (flips own other cell(two,three) x)) or cell(two,three) = candidate_a) ->
  (cell(three,zero) in own or cell(three,zero) in other or (forall x, not (flips own other cell(three,zero) x)) or cell(three,zero) = candidate_a) ->
  (cell(three,one) in own or cell(three,one) in other or (forall x, not (flips own other cell(three,one) x)) or cell(three,one) = candidate_a) ->
  (cell(three,two) in own or cell(three,two) in other or (forall x, not (flips own other cell(three,two) x)) or cell(three,two) = candidate_a) ->
  (cell(three,three) in own or cell(three,three) in other or (forall x, not (flips own other cell(three,three) x)) or cell(three,three) = candidate_a) ->
  can_place own other move -> move = candidate_a.
intros own other candidate_a move Ha Hb Hc Hd He Hf Hg Hh Hi Hj Hk Hl Hm Hn Ho Hp Hcan.
rule cut Hon_board : move in board.
cases Hcan Hprefix Hflips.
cases Hprefix Hboard_own Hother.
cases Hboard_own Hboard Hown.
exact Hboard.
specialize finite_board_members move as Hboard.
apply Hboard in Hon_board as Hsquares.
cases Hsquares Hsquares_left Hsquares_right.
cases Hsquares_left Hsquares_left_left Hsquares_left_right.
cases Hsquares_left_left Hsquares_left_left_left Hsquares_left_left_right.
cases Hsquares_left_left_left Hsquares_left_left_left_left Hsquares_left_left_left_right.
cases Hsquares_left_left_left_left Hsquares_left_left_left_left_left Hsquares_left_left_left_left_right.
cases Hsquares_left_left_left_left_left Hsquares_left_left_left_left_left_left Hsquares_left_left_left_left_left_right.
cases Hsquares_left_left_left_left_left_left Hsquares_left_left_left_left_left_left_left Hsquares_left_left_left_left_left_left_right.
cases Hsquares_left_left_left_left_left_left_left Hsquares_left_left_left_left_left_left_left_left Hsquares_left_left_left_left_left_left_left_right.
cases Hsquares_left_left_left_left_left_left_left_left Hsquares_left_left_left_left_left_left_left_left_left Hsquares_left_left_left_left_left_left_left_left_right.
cases Hsquares_left_left_left_left_left_left_left_left_left Hsquares_left_left_left_left_left_left_left_left_left_left Hsquares_left_left_left_left_left_left_left_left_left_right.
cases Hsquares_left_left_left_left_left_left_left_left_left_left Hsquares_left_left_left_left_left_left_left_left_left_left_left Hsquares_left_left_left_left_left_left_left_left_left_left_right.
cases Hsquares_left_left_left_left_left_left_left_left_left_left_left Hsquares_left_left_left_left_left_left_left_left_left_left_left_left Hsquares_left_left_left_left_left_left_left_left_left_left_left_right.
cases Hsquares_left_left_left_left_left_left_left_left_left_left_left_left Hsquares_left_left_left_left_left_left_left_left_left_left_left_left_left Hsquares_left_left_left_left_left_left_left_left_left_left_left_left_right.
cases Hsquares_left_left_left_left_left_left_left_left_left_left_left_left_left Hsquares_left_left_left_left_left_left_left_left_left_left_left_left_left_left Hsquares_left_left_left_left_left_left_left_left_left_left_left_left_left_right.
cases Hsquares_left_left_left_left_left_left_left_left_left_left_left_left_left_left Hsquares_left_left_left_left_left_left_left_left_left_left_left_left_left_left_left Hsquares_left_left_left_left_left_left_left_left_left_left_left_left_left_left_right.
specialize move_table_branch_one own other move cell(zero,zero) candidate_a as Hbranch.
apply Hbranch.
exact Hsquares_left_left_left_left_left_left_left_left_left_left_left_left_left_left_left.
exact Hcan.
exact Ha.
specialize move_table_branch_one own other move cell(zero,one) candidate_a as Hbranch.
apply Hbranch.
exact Hsquares_left_left_left_left_left_left_left_left_left_left_left_left_left_left_right.
exact Hcan.
exact Hb.
specialize move_table_branch_one own other move cell(zero,two) candidate_a as Hbranch.
apply Hbranch.
exact Hsquares_left_left_left_left_left_left_left_left_left_left_left_left_left_right.
exact Hcan.
exact Hc.
specialize move_table_branch_one own other move cell(zero,three) candidate_a as Hbranch.
apply Hbranch.
exact Hsquares_left_left_left_left_left_left_left_left_left_left_left_left_right.
exact Hcan.
exact Hd.
specialize move_table_branch_one own other move cell(one,zero) candidate_a as Hbranch.
apply Hbranch.
exact Hsquares_left_left_left_left_left_left_left_left_left_left_left_right.
exact Hcan.
exact He.
specialize move_table_branch_one own other move cell(one,one) candidate_a as Hbranch.
apply Hbranch.
exact Hsquares_left_left_left_left_left_left_left_left_left_left_right.
exact Hcan.
exact Hf.
specialize move_table_branch_one own other move cell(one,two) candidate_a as Hbranch.
apply Hbranch.
exact Hsquares_left_left_left_left_left_left_left_left_left_right.
exact Hcan.
exact Hg.
specialize move_table_branch_one own other move cell(one,three) candidate_a as Hbranch.
apply Hbranch.
exact Hsquares_left_left_left_left_left_left_left_left_right.
exact Hcan.
exact Hh.
specialize move_table_branch_one own other move cell(two,zero) candidate_a as Hbranch.
apply Hbranch.
exact Hsquares_left_left_left_left_left_left_left_right.
