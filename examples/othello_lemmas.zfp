(* 計数の中間値と各マスの計数ステップから、全体の石数を組み立てる。 *)
theorem count_from_steps : forall stones n_a n_b n_c n_d n_e n_f n_g n_h n_i n_j n_k n_l n_m n_n n_o n_p,
  (count_step stones cell(zero,zero) zero n_a) ->
  (count_step stones cell(zero,one) n_a n_b) ->
  (count_step stones cell(zero,two) n_b n_c) ->
  (count_step stones cell(zero,three) n_c n_d) ->
  (count_step stones cell(one,zero) n_d n_e) ->
  (count_step stones cell(one,one) n_e n_f) ->
  (count_step stones cell(one,two) n_f n_g) ->
  (count_step stones cell(one,three) n_g n_h) ->
  (count_step stones cell(two,zero) n_h n_i) ->
  (count_step stones cell(two,one) n_i n_j) ->
  (count_step stones cell(two,two) n_j n_k) ->
  (count_step stones cell(two,three) n_k n_l) ->
  (count_step stones cell(three,zero) n_l n_m) ->
  (count_step stones cell(three,one) n_m n_n) ->
  (count_step stones cell(three,two) n_n n_o) ->
  (count_step stones cell(three,three) n_o n_p) ->
  count stones n_p.
intros stones n_a n_b n_c n_d n_e n_f n_g n_h n_i n_j n_k n_l n_m n_n n_o n_p Hstep_a Hstep_b Hstep_c Hstep_d Hstep_e Hstep_f Hstep_g Hstep_h Hstep_i Hstep_j Hstep_k Hstep_l Hstep_m Hstep_n Hstep_o Hstep_p.
use n_a.
use n_b.
use n_c.
use n_d.
use n_e.
use n_f.
use n_g.
use n_h.
use n_i.
use n_j.
use n_k.
use n_l.
use n_m.
use n_n.
