intro x.
rewrite eq_stones_de.
specialize Hcup stones_e stones_da x as Hc.
specialize members_e x as Ha.
specialize members_da x as Hb.
split.
intro H.
apply -> Hc in H as Hunion.
cases Hunion Hleft Hright.
apply -> Ha in Hleft as Hcases.
left.
left.
exact Hcases.
apply -> Hb in Hright as Hcases.
cases Hcases Hitem_rest_b Hitem_b.
left.
right.
exact Hitem_rest_b.
right.
exact Hitem_b.
