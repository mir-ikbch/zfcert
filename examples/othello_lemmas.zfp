(* 局面の分解と白必勝の閉包規則 *)

theorem state_injective : forall B W turn C V next,
  state(B,W,turn) = state(C,V,next) ->
  (B = C and W = V and turn = next).
intros B W turn C V next H.
specialize opair_inj opair(B,W) opair(C,V) turn next as Houter_rule.
apply Houter_rule in H as Houter.
cases Houter.
specialize opair_inj B C W V as Hinner_rule.
apply Hinner_rule in Houter_left as Hinner.
split.
  exact Hinner.
  exact Houter_right.
qed.

theorem colors_distinct : not (black = white).
intro Heq.
specialize Hcup zero singleton(zero) zero as Hc.
specialize Hsingleton zero zero as Hs.
rule cut Hz : zero in white.
  apply <- Hc.
  right.
  apply <- Hs.
  refl.
rule cut Hn : not (zero in white).
  rule equal_elim black white a : not (zero in a).
  exact Heq.
  specialize Hempty zero as Hnzero.
  exact Hnzero.
contradiction.
qed.

theorem valid_turn_intro : forall B W turn,
  valid B W -> (turn = black or turn = white) ->
  valid_with_turn state(B,W,turn) turn.
intros B W turn Hv Hturn.
use B.
use W.
split.
  split.
    refl.
    exact Hv.
  exact Hturn.
qed.

theorem valid_state_intro : forall B W turn,
  valid B W -> (turn = black or turn = white) ->
  valid_state state(B,W,turn).
intros B W turn Hv Hturn.
use turn.
apply valid_turn_intro.
exact Hv.
exact Hturn.
qed.

theorem black_turn_intro : forall B W,
  valid B W -> black_turn state(B,W,black).
intros B W Hv.
apply valid_turn_intro.
exact Hv.
left.
refl.
qed.

theorem white_turn_intro : forall B W,
  valid B W -> white_turn state(B,W,white).
intros B W Hv.
specialize valid_turn_intro B W white as Hr.
apply Hr.
exact Hv.
right.
refl.
qed.

theorem closed_white_won : forall R s,
  white_win_closed R -> white_won s -> s in R.
intros R s Hclosed Hwon.
cases Hclosed.
cases Hclosed_left.
specialize Hclosed_left_left s as Hr.
apply Hr.
exact Hwon.
qed.

theorem closed_terminal : forall R B W turn,
  white_win_closed R -> terminal B W -> white_more B W ->
  (turn = black or turn = white) -> state(B,W,turn) in R.
intros R B W turn Hclosed Hterminal Hmore Hturn.
specialize closed_white_won R state(B,W,turn) as Hr.
apply Hr.
exact Hclosed.
use B.
use W.
use turn.
split.
  split.
    split.
      refl.
      exact Hturn.
    exact Hterminal.
  exact Hmore.
qed.

theorem closed_white : forall R B W t,
  white_win_closed R -> valid B W ->
  step state(B,W,white) t -> t in R -> state(B,W,white) in R.
intros R B W t Hclosed Hv Hstep Htarget.
cases Hclosed.
cases Hclosed_left.
specialize Hclosed_left_right state(B,W,white) t as Hr.
apply Hr.
split.
  split.
    specialize white_turn_intro B W as Hturn.
    apply Hturn.
    exact Hv.
    exact Hstep.
  exact Htarget.
qed.

theorem nonterminal_intro : forall B W turn,
  valid B W -> not (terminal B W) ->
  (turn = black or turn = white) -> nonterminal_state state(B,W,turn).
intros B W turn Hv Hnt Hturn.
use B.
use W.
use turn.
split.
  split.
    split.
      refl.
      exact Hturn.
    exact Hv.
  exact Hnt.
qed.

theorem closed_black : forall R B W,
  white_win_closed R -> valid B W -> not (terminal B W) ->
  (forall t, step state(B,W,black) t -> t in R) -> state(B,W,black) in R.
intros R B W Hclosed Hv Hnt Hall.
cases Hclosed.
specialize Hclosed_right state(B,W,black) as Hr.
apply Hr.
split.
  split.
    specialize black_turn_intro B W as Hturn.
    apply Hturn.
    exact Hv.
    specialize nonterminal_intro B W black as Hntr.
    apply Hntr.
    exact Hv.
    exact Hnt.
    left.
    refl.
  exact Hall.
qed.

theorem step_from_black : forall B W t,
  step state(B,W,black) t ->
  exists Bn Wn, t = state(Bn,Wn,white) and valid Bn Wn
    and turn_step B W Bn Wn.
intros B W t Hstep.
obtain C Hc from Hstep.
obtain V Hv from Hc.
obtain Cn Hcn from Hv.
obtain Vn Hvn from Hcn.
cases Hvn.
cases Hvn_left.
cases Hvn_right.
  cases Hvn_right_left.
  cases Hvn_right_left_left.
  specialize state_injective B W black C V black as Hsir.
  apply Hsir in Hvn_right_left_left_left as Hsi.
  cases Hsi.
  cases Hsi_left.
  use Cn.
  use Vn.
  split.
    split.
      exact Hvn_right_left_left_right.
      exact Hvn_left_right.
    rewrite Hsi_left_left.
    rewrite Hsi_left_right.
    exact Hvn_right_left_right.
  cases Hvn_right_right.
  cases Hvn_right_right_left.
  specialize state_injective B W black C V white as Hsir.
  apply Hsir in Hvn_right_right_left_left as Hsi.
  cases Hsi.
  put colors_distinct.
  contradiction.
qed.


theorem step_white_intro : forall B W Bn Wn,
  valid B W -> valid Bn Wn -> turn_step W B Wn Bn ->
  step state(B,W,white) state(Bn,Wn,black).
intros B W Bn Wn Hv Hvn Hturn.
use B.
use W.
use Bn.
use Wn.
split.
  split.
    exact Hv.
    exact Hvn.
  right.
  split.
    split.
      refl.
      refl.
    exact Hturn.
qed.

theorem after_place_unique : forall own other move A B C D,
  after_place own other move A B -> after_place own other move C D ->
  (A = C and B = D).
intros own other move A B C D Hfirst Hsecond.
cases Hfirst.
cases Hfirst_left.
cases Hsecond.
cases Hsecond_left.
split.
  apply extensionality.
  intro x.
  specialize Hfirst_left_right x as Hxfirst.
  specialize Hsecond_left_right x as Hxsecond.
  split.
    intro Hx.
    apply <- Hxsecond.
    apply -> Hxfirst.
    exact Hx.
    intro Hx.
    apply <- Hxfirst.
    apply -> Hxsecond.
    exact Hx.
  apply extensionality.
  intro x.
  specialize Hfirst_right x as Hxfirst.
  specialize Hsecond_right x as Hxsecond.
  split.
    intro Hx.
    apply <- Hxsecond.
    apply -> Hxfirst.
    exact Hx.
    intro Hx.
    apply <- Hxfirst.
    apply -> Hxsecond.
    exact Hx.
qed.

theorem turn_step_with_move : forall own other own_next other_next,
  has_move own other -> turn_step own other own_next other_next ->
  exists move, after_place own other move own_next other_next.
intros own other own_next other_next Hmove Hturn.
cases Hturn.
  exact Hturn_left.
  cases Hturn_right.
  cases Hturn_right_left.
  cases Hturn_right_left_left.
  contradiction.
qed.

theorem nonterminal_from_move : forall B W,
  has_move B W -> not (terminal B W).
intros B W Hmove Hterminal.
cases Hterminal.
cases Hterminal_left.
contradiction.
qed.

theorem nonterminal_from_other_move : forall B W,
  has_move W B -> not (terminal B W).
intros B W Hmove Hterminal.
cases Hterminal.
contradiction.
qed.

theorem closed_white_place : forall R B W Bn Wn move,
  white_win_closed R -> valid B W -> valid Bn Wn ->
  after_place W B move Wn Bn -> state(Bn,Wn,black) in R ->
  state(B,W,white) in R.
intros R B W Bn Wn move Hclosed Hv Hvn Hafter Htarget.
specialize closed_white R B W state(Bn,Wn,black) as Hrule.
apply Hrule.
exact Hclosed.
exact Hv.
specialize step_white_intro B W Bn Wn as Hstep.
apply Hstep.
exact Hv.
exact Hvn.
left.
use move.
exact Hafter.
exact Htarget.
qed.

(* 閉包集合の存在と主張の非空虚性 *)

choose state_powerset Hstate_powerset from power_set board.
definition all_states :=
  prod(prod(state_powerset,state_powerset), pair(black,white)).

theorem valid_state_in_all_states : forall s,
  valid_state s -> s in all_states.
intros s Hvalid_state.
obtain turn Hturn from Hvalid_state.
obtain B Hb from Hturn.
obtain W Hw from Hb.
cases Hw Hstate_valid Hcolor.
cases Hstate_valid Hstate Hvalid.
cases Hvalid Hsubsets Hdisjoint.
cases Hsubsets Hbsub Hwsub.
specialize Hprod prod(state_powerset,state_powerset) pair(black,white) s as Houter.
apply <- Houter.
use opair(B,W).
use turn.
split.
  split.
    specialize Hprod state_powerset state_powerset opair(B,W) as Hinner.
    apply <- Hinner.
    use B.
    use W.
    split.
      split.
        specialize Hstate_powerset B as Hbpower.
        apply <- Hbpower.
        exact Hbsub.
        specialize Hstate_powerset W as Hwpower.
        apply <- Hwpower.
        exact Hwsub.
      refl.
    specialize Hpair black white turn as Hcolors.
    apply <- Hcolors.
    exact Hcolor.
  exact Hstate.
qed.

theorem white_won_is_valid : forall s, white_won s -> valid_state s.
intros s Hwon.
obtain B Hb from Hwon.
obtain W Hw from Hb.
obtain turn Hturn from Hw.
cases Hturn Hprefix Hscore.
cases Hprefix Hstate_color Hterminal.
cases Hstate_color Hstate Hcolor.
cases Hterminal Hvalid_and_no_move Hno_other_move.
cases Hvalid_and_no_move Hvalid Hno_move.
use turn.
use B.
use W.
split.
  split.
    exact Hstate.
    exact Hvalid.
  exact Hcolor.
qed.

theorem all_states_closed : white_win_closed all_states.
split.
  split.
    intros s Hwon.
    apply valid_state_in_all_states.
    apply white_won_is_valid.
    exact Hwon.
    intros s t Hrule.
    cases Hrule Hturn_step Htarget.
    cases Hturn_step Hwhite Hstep.
    apply valid_state_in_all_states.
    use white.
    exact Hwhite.
  intros s Hrule.
  cases Hrule Hturn_nonterminal Hall.
  cases Hturn_nonterminal Hblack Hnonterminal.
  apply valid_state_in_all_states.
  use black.
  exact Hblack.
qed.

theorem exists_white_win_closed : exists R, white_win_closed R.
use all_states.
exact all_states_closed.
qed.

