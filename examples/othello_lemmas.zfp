(* 局面を表す有限集合と、その所属・妥当性の証明 *)

theorem mask_identity_choice : forall x, exists y, y = x.
intro x.
use x.
refl.
qed.
choose stones_baai eq_stones_baai from mask_identity_choice pair(cell(zero,three),cell(three,zero)).
theorem members_baai : forall x, x in stones_baai <-> (x = cell(zero,three) or x = cell(three,zero)).
intro x.
rewrite eq_stones_baai.
specialize Hpair cell(zero,three) cell(three,zero) x as Hm.
exact Hm.
qed.
choose stones_d eq_stones_d from mask_identity_choice pair(cell(zero,zero),cell(zero,one)).
theorem members_d : forall x, x in stones_d <-> (x = cell(zero,zero) or x = cell(zero,one)).
intro x.
rewrite eq_stones_d.
specialize Hpair cell(zero,zero) cell(zero,one) x as Hm.
exact Hm.
qed.
choose stones_e eq_stones_e from mask_identity_choice singleton(cell(zero,two)).
theorem members_e : forall x, x in stones_e <-> (x = cell(zero,two)).
intro x.
rewrite eq_stones_e.
specialize Hsingleton cell(zero,two) x as Hm.
exact Hm.
qed.
choose stones_da eq_stones_da from mask_identity_choice pair(cell(one,zero),cell(one,one)).
theorem members_da : forall x, x in stones_da <-> (x = cell(one,zero) or x = cell(one,one)).
intro x.
rewrite eq_stones_da.
specialize Hpair cell(one,zero) cell(one,one) x as Hm.
exact Hm.
qed.
choose stones_de eq_stones_de from mask_identity_choice cup(stones_e,stones_da).
