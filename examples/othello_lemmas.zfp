    exact Hcol.
qed.

theorem finite_direction_row_off : forall dr dc r c,
  (forall rr, not (axis_step dr r rr)) ->
  forall q, not (direction_step dr dc cell(r,c) q).
intros dr dc r c Hoff q Hdir.
cases Hdir Hnot Hex.
obtain a Ha from Hex.
obtain b Hb from Ha.
obtain rr Hrr from Hb.
obtain cc Hcc from Hrr.
cases Hcc Hprefix Hcol.
cases Hprefix Hpq Hrow.
cases Hpq Hp Hq.
specialize opair_inj r a c b as Hinj.
apply Hinj in Hp as Hcoords.
cases Hcoords Hr Hc.
specialize Hoff rr as Hbad.
apply Hbad.
rewrite Hr.
exact Hrow.
qed.

theorem finite_direction_col_off : forall dr dc r c,
  (forall cc, not (axis_step dc c cc)) ->
  forall q, not (direction_step dr dc cell(r,c) q).
intros dr dc r c Hoff q Hdir.
cases Hdir Hnot Hex.
obtain a Ha from Hex.
obtain b Hb from Ha.
obtain rr Hrr from Hb.
obtain cc Hcc from Hrr.
cases Hcc Hprefix Hcol.
cases Hprefix Hpq Hrow.
cases Hpq Hp Hq.
specialize opair_inj r a c b as Hinj.
apply Hinj in Hp as Hcoords.
cases Hcoords Hr Hc.
specialize Hoff cc as Hbad.
apply Hbad.
rewrite Hc.
exact Hcol.
qed.

