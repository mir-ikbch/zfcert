theorem finite_common_source : forall x a b, x = a -> x = b -> a = b.
intros x a b Ha Hb.
rule equal_elim x a z : z = b.
exact Ha.
exact Hb.
qed.
theorem finite_common_value : forall a b x, a = x -> b = x -> a = b.
intros a b x Ha Hb.
rule equal_elim x b z : a = z.
apply eq_sym.
exact Hb.
exact Ha.
qed.
theorem finite_succ_injective : forall a b, succ(a) = succ(b) -> a = b.
intros a b Heq.
specialize finite_succ_members b a as Habchar.
specialize finite_succ_members a a as Haachar.
rule cut Hab : a in b or a = b.
  apply -> Habchar.
  rewrite <- Heq.
  apply <- Haachar.
  right.
  refl.
cases Hab Hainb Hequal.
  specialize finite_succ_members a b as Hbachar.
  specialize finite_succ_members b b as Hbbchar.
  rule cut Hba : b in a or b = a.
    apply -> Hbachar.
    rewrite Heq.
    apply <- Hbbchar.
    right.
    refl.
  cases Hba Hbina Hreverse.
    rule falsum_elim.
    specialize no_two_cycle a b as Hcycle.
    apply Hcycle.
      exact Hainb.
      exact Hbina.
    apply eq_sym.
    exact Hreverse.
  exact Hequal.
qed.

