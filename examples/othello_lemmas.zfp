  (x in A <-> (x = p_a or x = p_b)) ->
  (x in B <-> (x = p_c or x = p_d or x = p_e)) ->
  (x in cup(A,B) <->  (x = p_a or x = p_b or x = p_c or x = p_d or x = p_e)).
intros A B p_a p_b p_c p_d p_e x Ha Hb.
specialize Hcup A B x as Hc.
split.
intro H.
apply -> Hc in H as Hunion.
cases Hunion Hleft Hright.
