theorem finite_direction_functional : forall dr dc p q1 q2, direction_step dr dc p q1 -> direction_step dr dc p q2 -> q1 = q2.
intros dr dc p q1 q2 H1 H2.
cases H1 Hnot1 Hex1.
cases H2 Hnot2 Hex2.
obtain r1 H1_r from Hex1.
obtain c1 H1_c from H1_r.
obtain rr1 H1_rr from H1_c.
obtain cc1 H1_cc from H1_rr.
cases H1_cc H1_prefix H1_col.
cases H1_prefix H1_pq H1_row.
cases H1_pq H1_p H1_q.
obtain r2 H2_r from Hex2.
obtain c2 H2_c from H2_r.
obtain rr2 H2_rr from H2_c.
obtain cc2 H2_cc from H2_rr.
cases H2_cc H2_prefix H2_col.
cases H2_prefix H2_pq H2_row.
cases H2_pq H2_p H2_q.
rule cut Hp_same : cell(r1,c1) = cell(r2,c2).
specialize finite_common_source p cell(r1,c1) cell(r2,c2) as Hp_common.
apply Hp_common.
exact H1_p.
exact H2_p.
specialize opair_inj r1 r2 c1 c2 as Hinj.
apply Hinj in Hp_same as Hcoords.
cases Hcoords Hr_same Hc_same.
rule cut Hrow1 : axis_step dr r2 rr1.
rule equal_elim r1 r2 z : axis_step dr z rr1.
exact Hr_same.
exact H1_row.
rule cut Hcol1 : axis_step dc c2 cc1.
rule equal_elim c1 c2 z : axis_step dc z cc1.
exact Hc_same.
exact H1_col.
specialize finite_axis_functional dr r2 rr1 rr2 as Hrow_fun.
rule cut Hrr_same : rr1 = rr2.
apply Hrow_fun.
exact Hrow1.
exact H2_row.
specialize finite_axis_functional dc c2 cc1 cc2 as Hcol_fun.
rule cut Hcc_same : cc1 = cc2.
apply Hcol_fun.
exact Hcol1.
exact H2_col.
specialize finite_cell_transport q1 rr1 cc1 rr2 cc2 as Hq1transport.
rule cut Hq1 : q1 = cell(rr2,cc2).
apply Hq1transport.
exact H1_q.
exact Hrr_same.
exact Hcc_same.
specialize finite_common_value q1 q2 cell(rr2,cc2) as Hq_common.
apply Hq_common.
exact Hq1.
exact H2_q.
qed.
theorem finite_direction_row_intro : forall dr dc r c rr cc,
  not (dr = one) -> axis_step dr r rr -> axis_step dc c cc ->
  direction_step dr dc cell(r,c) cell(rr,cc).
intros dr dc r c rr cc Hrownot Hrow Hcol.
split.
  intro Hstay.
  cases Hstay Hrowstay Hcolstay.
  apply Hrownot.
  exact Hrowstay.
  use r.
  use c.
  use rr.
  use cc.
  split.
    split.
      split.
        refl.
        refl.
      exact Hrow.
    exact Hcol.
qed.

