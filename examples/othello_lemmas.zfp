apply Hunique.
exact Hground.
exact after_place_cea_eca_l.
cases Hsame Hsame_b Hsame_w.
left.
right.
rewrite Htarget.
rewrite Hsame_b.
rewrite Hsame_w.
refl.
rule cut Hground : after_place stones_cea stones_eca cell(three,two) Bn Wn.
rule equal_elim move cell(three,two) z : after_place stones_cea stones_eca z Bn Wn.
exact Hchoices_right.
exact Hafter.
rule cut Hsame : Bn = stones_egea and Wn = stones_ca.
specialize after_place_unique stones_cea stones_eca cell(three,two) Bn Wn stones_egea stones_ca as Hunique.
apply Hunique.
exact Hground.
exact after_place_cea_eca_o.
cases Hsame Hsame_b Hsame_w.
right.
rewrite Htarget.
rewrite Hsame_b.
rewrite Hsame_w.
refl.
qed.

