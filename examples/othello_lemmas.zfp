(* 方向と反転の有限場合分け *)

theorem squares_distinct_a_b : not (cell(zero,zero) = cell(zero,one)).
intro H.
specialize opair_inj zero zero zero one as Hinj.
apply Hinj in H as Hcoords.
cases Hcoords Hrow Hcol.
apply finite_neq_zero_one.
exact Hcol.
qed.
