(* 反転集合の所属証明から合法な着手を組み立てる。 *)
theorem can_place_from_capture : forall own other move captured point,
  move in board -> not (move in own) -> not (move in other) ->
  (forall x, flips own other move x <-> x in captured) ->
  point in captured -> can_place own other move.
intros own other move captured point Hboard Hnotown Hnotother Hcaptures Hpoint.
split.
split.
split.
exact Hboard.
exact Hnotown.
exact Hnotother.
use point.
specialize Hcaptures point as Hcap.
apply <- Hcap.
exact Hpoint.
qed.

theorem can_place_h_oha_i : can_place stones_h stones_oha cell(two,zero).
