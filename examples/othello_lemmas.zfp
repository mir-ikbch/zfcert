theorem othello_direction_transport : forall dr dc p q dr1 dc1 p1,
  dr = dr1 -> dc = dc1 -> p = p1 ->
  direction_step dr dc p q -> direction_step dr1 dc1 p1 q.
intros dr dc p q dr1 dc1 p1 Hdr Hdc Hp Hdir.
rule equal_elim dr dr1 d : direction_step d dc1 p1 q.
exact Hdr.
rule equal_elim dc dc1 d : direction_step dr d p1 q.
exact Hdc.
rule equal_elim p p1 v : direction_step dr dc v q.
exact Hp.
exact Hdir.
qed.

theorem othello_eq_right_transport : forall x a ca,
  a = ca -> x = a -> x = ca.
intros x a ca Ha Hx.
rule equal_elim a ca v : x = v.
exact Ha.
exact Hx.
qed.

theorem othello_two_eq_transport : forall x a b ca cb,
  a = ca -> b = cb -> (x = a or x = b) -> (x = ca or x = cb).
intros x a b ca cb Ha Hb Hx.
rule equal_elim a ca v : (x = v or x = cb).
exact Ha.
rule equal_elim b cb v : (x = a or x = v).
exact Hb.
exact Hx.
qed.

theorem othello_flips_sound : forall own other move x,
  flips own other move x -> othello_flips_cases own other move x.
intros own other move x Hflip.
