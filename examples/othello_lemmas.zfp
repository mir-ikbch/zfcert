theorem finite_direction_off_0_0_0_0 : forall q, not (direction_step zero zero cell(zero,zero) q).
intros q Hdir.
cases Hdir Hnot Hex.
obtain r Hr from Hex.
obtain c Hc from Hr.
obtain rr Hrr from Hc.
obtain cc Hcc from Hrr.
cases Hcc Hprefix Hcol.
cases Hprefix Hpq Hrow.
cases Hpq Hp Hq.
specialize opair_inj zero r zero c as Hinj.
apply Hinj in Hp as Hcoords.
cases Hcoords Hr_eq Hc_eq.
rule cut Hcoord_eq : r = zero.
rule equal_elim zero r z : z = zero.
exact Hr_eq.
refl.
rule cut Hbad : axis_step zero zero rr.
rule equal_elim r zero z : axis_step zero z rr.
exact Hcoord_eq.
exact Hrow.
specialize finite_axis_off_decrease rr as Hoff.
apply Hoff.
exact Hbad.
qed.
