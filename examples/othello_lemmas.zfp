  (((((((move = cell(zero, zero) and cell(zero, one) in other and cell(zero, two) in own and (x = cell(zero, one))) or (move = cell(zero, zero) and cell(zero, one) in other and cell(zero, two) in other and cell(zero, three) in own and (x = cell(zero, one) or x = cell(zero, two)))) or ((move = cell(zero, zero) and cell(one, zero) in other and cell(two, zero) in own and (x = cell(one, zero))) or (move = cell(zero, zero) and cell(one, zero) in other and cell(two, zero) in other and cell(three, zero) in own and (x = cell(one, zero) or x = cell(two, zero))))) or (((move = cell(zero, zero) and cell(one, one) in other and cell(two, two) in own and (x = cell(one, one))) or (move = cell(zero, zero) and cell(one, one) in other and cell(two, two) in other and cell(three, three) in own and (x = cell(one, one) or x = cell(two, two)))) or ((move = cell(zero, one) and cell(zero, two) in other and cell(zero, three) in own and (x = cell(zero, two))) or (move = cell(zero, one) and cell(one, one) in other and cell(two, one) in own and (x = cell(one, one)))))) or ((((move = cell(zero, one) and cell(one, one) in other and cell(two, one) in other and cell(three, one) in own and (x = cell(one, one) or x = cell(two, one))) or (move = cell(zero, one) and cell(one, two) in other and cell(two, three) in own and (x = cell(one, two)))) or ((move = cell(zero, two) and cell(zero, one) in other and cell(zero, zero) in own and (x = cell(zero, one))) or (move = cell(zero, two) and cell(one, one) in other and cell(two, zero) in own and (x = cell(one, one))))) or (((move = cell(zero, two) and cell(one, two) in other and cell(two, two) in own and (x = cell(one, two))) or (move = cell(zero, two) and cell(one, two) in other and cell(two, two) in other and cell(three, two) in own and (x = cell(one, two) or x = cell(two, two)))) or ((move = cell(zero, three) and cell(zero, two) in other and cell(zero, one) in own and (x = cell(zero, two))) or ((move = cell(zero, three) and cell(zero, two) in other and cell