(* 石の有無に応じた、各マスの計数ステップ。 *)
theorem count_step_present : forall stones square before,
  square in stones -> count_step stones square before succ(before).
intros stones square before Hstone.
left.
split.
exact Hstone.
refl.
qed.
theorem count_step_absent : forall stones square before,
  not (square in stones) -> count_step stones square before before.
intros stones square before Hstone.
right.
split.
exact Hstone.
refl.
qed.

theorem score_count_c : count stones_c one.
specialize count_from_steps stones_c zero one one one one one one one one one one one one one one one as Hcount.
apply Hcount.
specialize count_step_absent stones_c cell(zero,zero) zero as Hstep.
apply Hstep.
exact member_c_a.
specialize count_step_present stones_c cell(zero,one) zero as Hstep.
apply Hstep.
exact member_c_b.
specialize count_step_absent stones_c cell(zero,two) one as Hstep.
apply Hstep.
exact member_c_c.
