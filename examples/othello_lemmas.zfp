theorem score_identity_choice : forall x, exists y, y = x.
intro x.
use x.
refl.
qed.
choose five score_five_eq from score_identity_choice succ(four).
choose six score_six_eq from score_identity_choice succ(five).
choose seven score_seven_eq from score_identity_choice succ(six).
choose eight score_eight_eq from score_identity_choice succ(seven).
choose nine score_nine_eq from score_identity_choice succ(eight).
choose ten score_ten_eq from score_identity_choice succ(nine).
choose eleven score_eleven_eq from score_identity_choice succ(ten).
choose twelve score_twelve_eq from score_identity_choice succ(eleven).
theorem score_succ_contains : forall a, a in succ(a).
intro a.
specialize finite_succ_members a a as Hm.
apply <- Hm.
right.
refl.
qed.
