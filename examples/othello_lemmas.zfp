(* 列挙の各位置にある要素の所属を共通化する。 *)

theorem finite_member_two_a : forall S p_a p_b,
  (forall y, y in S <-> (y = p_a or y = p_b)) -> p_a in S.
intros S p_a p_b Hchar.
specialize Hchar p_a as Hm.
apply <- Hm.
left.
refl.
qed.

