cases Hcases_right_left Hprefix_3 Hwhich.
cases Hprefix_3 Hprefix_2 Hstone_2.
cases Hprefix_2 Hstone_0 Hstone_1.
apply Hcapture_fact_c.
exact Hstone_1.
cases Hcases_right_right Hcases_right_right_left Hcases_right_right_right.
cases Hcases_right_right_left Hprefix_2 Hwhich.
cases Hprefix_2 Hstone_0 Hstone_1.
apply Hcapture_fact_d.
exact Hstone_1.
cases Hcases_right_right_right Hprefix_3 Hwhich.
cases Hprefix_3 Hprefix_2 Hstone_2.
cases Hprefix_2 Hstone_0 Hstone_1.
apply Hcapture_fact_e.
exact Hstone_2.
qed.

