specialize nonterminal_from_move stones_faaa stones_phh as Hnt.
apply Hnt.
use cell(zero,three).
exact can_place_faaa_phh_d.
exact Hterminal.
qed.
theorem successors_bo : forall t, step certificate_state_bo t -> (t = certificate_state_bn).
intros t Hstep.
specialize step_from_black stones_faaa stones_phh t as Hfrom.
apply Hfrom in Hstep as Hex.
obtain Bn Hbn from Hex.
obtain Wn Hwn from Hbn.
cases Hwn Hprefix Hturn.
cases Hprefix Htarget Hvalid.
rule cut Hhas : has_move stones_faaa stones_phh.
use cell(zero,three).
exact can_place_faaa_phh_d.
rule cut Hplacement : exists move, after_place stones_faaa stones_phh move Bn Wn.
specialize turn_step_with_move stones_faaa stones_phh Bn Wn as Hwith.
apply Hwith.
exact Hhas.
exact Hturn.
obtain move Hafter from Hplacement.
cases Hafter Hfirst Hother.
cases Hfirst Hcan Hown.
specialize legal_moves_faaa_phh move as Hlist.
apply Hlist in Hcan as Hchoices.
rule cut Hground : after_place stones_faaa stones_phh cell(zero,three) Bn Wn.
rule equal_elim move cell(zero,three) z : after_place stones_faaa stones_phh z Bn Wn.
exact Hchoices.
exact Hafter.
rule cut Hsame : Bn = stones_fcei and Wn = stones_ndh.
specialize after_place_unique stones_faaa stones_phh cell(zero,three) Bn Wn stones_fcei stones_ndh as Hunique.
apply Hunique.
exact Hground.
exact after_place_faaa_phh_d.
cases Hsame Hsame_b Hsame_w.
rewrite Htarget.
rewrite Hsame_b.
rewrite Hsame_w.
refl.
qed.
