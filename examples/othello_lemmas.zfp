(* 終局の石数の検証 *)

theorem score_identity_choice : forall x, exists y, y = x.
intro x.
use x.
refl.
qed.
choose five score_five_eq from score_identity_choice succ(four).
choose six score_six_eq from score_identity_choice succ(five).
choose seven score_seven_eq from score_identity_choice succ(six).
choose eight score_eight_eq from score_identity_choice succ(seven).
choose nine score_nine_eq from score_identity_choice succ(eight).
choose ten score_ten_eq from score_identity_choice succ(nine).
choose eleven score_eleven_eq from score_identity_choice succ(ten).
choose twelve score_twelve_eq from score_identity_choice succ(eleven).
theorem score_succ_contains : forall a, a in succ(a).
intro a.
specialize finite_succ_members a a as Hm.
apply <- Hm.
right.
refl.
qed.
theorem score_less_one_ten : one in ten.
rewrite score_ten_eq.
specialize finite_succ_members nine one as Hstep_ten.
apply <- Hstep_ten.
left.
rewrite score_nine_eq.
specialize finite_succ_members eight one as Hstep_nine.
apply <- Hstep_nine.
left.
rewrite score_eight_eq.
specialize finite_succ_members seven one as Hstep_eight.
apply <- Hstep_eight.
left.
rewrite score_seven_eq.
specialize finite_succ_members six one as Hstep_seven.
apply <- Hstep_seven.
left.
rewrite score_six_eq.
specialize finite_succ_members five one as Hstep_six.
apply <- Hstep_six.
left.
rewrite score_five_eq.
specialize finite_succ_members four one as Hstep_five.
apply <- Hstep_five.
left.
specialize finite_succ_members three one as Hstep_four.
apply <- Hstep_four.
left.
specialize finite_succ_members two one as Hstep_three.
apply <- Hstep_three.
left.
specialize score_succ_contains one as Hbase.
exact Hbase.
qed.
