Choose empty empty_is_empty from empty_set.

Choose pair Hpair from pairing.

theorem exists_ordpair : forall x, forall y, exists p, forall z, (z in p) <-> (z = x or z = pair(x, y)).
intros x y.
specialize pairing x pair(x,y) as H.
apply H.
qed.

Choose ordpair Hordpair from exists_ordpair.

theorem exists_singleton : forall x, exists p, forall y, (y in p) <-> (y = x).
intro x.
specialize pairing x x as H.
put Hordpair.
resolution.
qed.

Choose singleton Hsingleton from exists_singleton.

theorem exists_cup : forall x, forall y, exists u, forall z, (z in u <-> z in x or z in y).
intro x.
intro y.
specialize union pair(x,y) as H.
obtain u Hu from H.
use u.
intro z.
specialize Hu z as Huz.
cases Huz.
split.
  intro Hzinu.
  rule cut Hex : exists y', z in y' and y' in pair(x,y).
    apply Huz_forward.
    exact Hzinu.
  obtain y' Hy' from Hex.
  cases Hy'.
  rule cut Hy'eq : y' = x or y' = y.
    specialize Hpair x y y' as Hp.
    cases Hp.
    apply Hp_forward.
    exact Hy'_right.
  cases Hy'eq.
  left.
  rewrite <- Hy'eq_left.
  exact Hy'_left.
  right.
  rewrite <- Hy'eq_right.
  exact Hy'_left.
  intro Hor.
  cases Hor.
  apply Huz_backward.
  use x.
  split.
    exact Hor_left.
    specialize Hpair x y x as Hp.
    cases Hp.
    apply Hp_backward.
    left.
    refl.
    apply Huz_backward.
    use y.
    specialize Hpair x y y as Hp.
    cases Hp.
    split.
      exact Hor_right.
      apply Hp_backward.
      right.
      refl.
qed.

Choose cup Hcup from exists_cup.

theorem exists_succ : forall x, exists u, forall z, (z in u <-> z in x or z in singleton(x)).
intro x.
specialize exists_cup x singleton(x) as Hc.
exact Hc.
qed.

Choose succ Hsucc from exists_succ.

alias is_emp_or_succ n := n = empty() or exists k, n = succ(k).
alias is_natural n := is_emp_or_succ n and forall m, m in n -> is_emp_or_succ m.

Choose inf Hinf from infinity.

theorem separation_nat : forall a, exists b, forall x, x in b <-> x in a and is_natural x.
intro a.
separation S a x : is_natural x.
exact S.
qed.

theorem separation_infnat : exists b, forall x, x in b <-> x in inf and is_natural x.
specialize separation_nat inf as H.
apply H.
qed.

Choose nat Hnat from separation_infnat.

Choose pow Hpow from power_set.

theorem exists_prod :
forall x y, exists pr, forall w,
       w in pr <->
       exists u v, w = ordpair(u,v) and (u in x and v in y).
intros.
separation S pow(pow(cup(x,y))) w : exists u v, w = ordpair(u,v) and (u in x and v in y).
obtain pr Hpr from S.
use pr.
intro w.
specialize Hpr w as Hw.
cases Hw.
split.
  intro Hwin.
  apply Hw_forward in Hwin as Hw'.
  cases Hw'.
  resolution.
  
  intro H.
  obtain u Hu from H.
  obtain v Hv from Hu.
  apply Hw_backward.
  split.
    cases Hv.
    specialize Hpow pow(cup(x,y)) w as Hpow1.
    cases Hpow1.
    apply Hpow1_backward.
    intros.
    specialize Hpow cup(x,y) z as Hpow2.
    cases Hpow2.
    apply Hpow2_backward.
    intros.
    specialize Hcup x y x'' as Hc.
    cases Hc.
    apply Hc_backward.
    
    
  



theorem pair_eq :
  forall p1,
  forall x1,
  forall y1,
  forall p2,
  forall x2,
  forall y2,
    ordpair p1 x1 y1 ->
    (ordpair p2 x2 y2 ->
      ((x1 = x2) and (y1 = y2) <-> (p1 = p2))).
intro p1.
intro x1.
intro y1.
intro p2.
intro x2.
intro y2.
intro H1.
intro H2.
split.
  intro Heq.
  cases Heq.
  apply extensionality.
  intro z.
  specialize pairing x1 y1 as H.
  cases H x1y1 Hx1y1.
  specialize H1 x1y1 as Ha.
  rule cut Hax :
     forall z, z in p1 <-> (z = x1 or z = x1y1).
    apply Ha.
    exact Hx1y1.
  specialize pairing x2 y2 as H'.
  cases H' x2y2 Hx2y2.
  rule cut Hb : (∀z, z ∈ p2 ↔ z = x2 ∨ z = x2y2).
    apply H2.
    exact Hx2y2.
  split.
    intro Hz.
    specialize Hax z as Haxz.
    rule cut Hzor :
       z = x1 or z = x1y1.
      cases Haxz.
      apply Haxz_forward.
      exact Hz.
    specialize Hb x2 as Hbx2.
    cases Hbx2.
    rule disj_elim HL HR :
       z = x1;
        z = x1y1.
      exact Hzor.
    rule equal_elim x1 z a : a in p2.
      rule equal_elim z x1 a : a = z.
        exact HL.
      refl.
    rule equal_elim x2 x1 a : a in p2.
      rule equal_elim x1 x2 a : a = x1.
        exact Heq_left.
      refl.
    apply Hbx2_backward.
      left.
      refl.
    specialize Hb z as Hbz.
    cases Hbz.
    apply Hbz_backward.
    right.
    rule equal_elim x1y1 z a : a = x2y2.
      rule equal_elim z x1y1 a : a = z.
        exact HR.
      refl.
    apply extensionality.
    intro w.
    split.
      intro Hw.
      specialize Hx2y2 w as Hwx2y2.
      cases Hwx2y2.
      apply Hwx2y2_backward.
      specialize Hx1y1 w as Hwx1y1.
      cases Hwx1y1.
      rule cut Hweq : w = x1 or w = y1.
        apply Hwx1y1_forward.
        exact Hw.
      rule disj_elim HwL HwR :
         w = x1;
         w = y1.
        exact Hweq.
      left.
      rule equal_elim x1 x2 a : w = a.
        exact Heq_left.
      exact HwL.
    right.
    rule equal_elim y1 y2 a : w = a.
      exact Heq_right.
    exact HwR.
    intro Hw.
    specialize Hx2y2 w as Hwx2y2.
    cases Hwx2y2.
    rule cut Hweq : w = x2 or w = y2.
      apply Hwx2y2_forward.
      exact Hw.
    specialize Hx1y1 w as Hwx1y1.
    cases Hwx1y1.
    apply Hwx1y1_backward.
    rule disj_elim HwL HwR :
        w = x2;
          w = y2.
      exact Hweq.
      left.
      rule equal_elim x2 x1 a : w = a.
        rule equal_elim x1 x2 a : a = x1.
          exact Heq_left.
        refl.
      exact HwL.
    right.
    rule equal_elim y2 y1 a : w = a.
      rule equal_elim y1 y2 a : a = y1.
        exact Heq_right.
      refl.
    exact HwR.
  intro Hz.
