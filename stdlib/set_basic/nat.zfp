alias contains_nat s := zero in s and (forall x, x in s -> succ(x) in s).

alias contained_nat s := forall x, x in s -> x = zero or exists x', x = succ(x').

theorem succ_unique :
        forall x, forall sx,
        (forall z, z in sx <-> z in x or z = x) -> succ(x) = sx.
intros x sx H.
specialize extensionality succ(x) sx as H'.
apply H'.
intro z.
split.
  intro H0.
  specialize Hsucc x z as Hz.
  cases Hz.
  apply Hz_forward in H0 as H0z.
  cases H0z.
  specialize H z as Hz'.
  cases Hz'.
  apply Hz'_backward.
  left.
  apply H0z_left.
  specialize H z as Hz'.
  cases Hz'.
  apply Hz'_backward.
  right.
  specialize Hsingleton x z as Hsing.
  resolution.
  intro Hzinsx.
  specialize H z as Hz.
  cases Hz.
  apply Hz_forward in Hzinsx as Hz'.
  specialize Hsucc x z as Hsuccz.
  cases Hsuccz.
  cases Hz'.
    apply Hsuccz_backward.
    left.
    exact Hz'_left.
    apply Hsuccz_backward.
    right.
    specialize Hsingleton x z as Hsing.
    cases Hsing.
    apply Hsing_backward.
    apply Hz'_right.
qed.
  

theorem inf_zs : exists i, contains_nat i.
obtain inft Hinft from infinity.
use inft.
cases Hinft.
obtain e He from Hinft_left.
cases He.
split.
  rule cut Hezero : zero = e.
    apply empty_unique.
      exact Hzero.
      exact He_left.
    rewrite Hezero.
    exact He_right.
  intros x H.
  specialize Hinft_right x as Hs.
  apply Hs in H as Hs'.
  cases Hs' y Hy.
  cases Hy.
  rule cut y_is_succ : succ(x) = y.
    apply succ_unique.
    exact Hy_right.
  rewrite y_is_succ.
  apply Hy_left.
qed.

choose inf Hinf from inf_zs.

theorem exists_nat : exists nat, contains_nat nat and contained_nat nat.
separation Hnat inf x : x = zero or (exists x', x = succ(x')).
obtain nat Hnat' from Hnat.
cases Hinf.
use nat.
split.
  split.
    specialize Hnat' zero as Hnatzero.
    cases Hnatzero.
    apply Hnatzero_backward.
    split.
      exact Hinf_left.
      left.
      refl.
    intros.
    specialize Hnat' succ(x) as Hnats.
    cases Hnats.
    apply Hnats_backward.
    split.
      resolution.
      right.
      use x.
      refl.
    intros.
    specialize Hnat' x as Hnatx.
    cases Hnatx.
    apply Hnatx_forward in H as Hnatx'.
    cases Hnatx'.
    exact Hnatx'_right.
qed.

theorem exists_nat_minimal : exists n,
  (contains_nat n and contained_nat n) and
  (forall s, contains_nat s -> subset n s).
obtain m Hm from exists_nat.
cases Hm.
cases Hm_left.
separation Hsep m x : forall s, contains_nat s -> x in s.
obtain n Hchar from Hsep.
use n.
split.
  split.
    split.
      specialize Hchar zero as Hz.
      cases Hz.
      apply Hz_backward.
      split.
        exact Hm_left_left.
        intros s Hs.
        cases Hs.
        exact Hs_left.
      intros x Hx.
      specialize Hchar x as Hxc.
      cases Hxc.
      apply Hxc_forward in Hx as Hxx.
      cases Hxx.
      specialize Hchar succ(x) as Hsc.
      cases Hsc.
      apply Hsc_backward.
      split.
        apply Hm_left_right.
        exact Hxx_left.
        intros s Hs.
        specialize Hxx_right s as Hxs.
        apply Hxs in Hs as Hxin.
        cases Hs.
        apply Hs_right.
        exact Hxin.
    intros x Hx.
    specialize Hchar x as Hxc.
    cases Hxc.
    apply Hxc_forward in Hx as Hxx.
    cases Hxx.
    specialize Hm_right x as Hmx.
    apply Hmx.
    exact Hxx_left.
  intros s Hs x Hx.
  specialize Hchar x as Hxc.
  cases Hxc.
  apply Hxc_forward in Hx as Hxx.
  cases Hxx.
  specialize Hxx_right s as Huniv.
  apply Huniv.
  exact Hs.
qed.

choose nat Hnat_minimal from exists_nat_minimal.

theorem Hnat : contains_nat nat and contained_nat nat.
cases Hnat_minimal.
exact Hnat_minimal_left.
qed.

theorem nat_ind :
  forall s,
    subset s nat ->
    zero in s ->
    (forall x, x in s -> succ(x) in s) ->
    s = nat.
intros s Hsub Hz Hs.
cases Hnat_minimal.
specialize Hnat_minimal_right s as Hmin.
rule cut Hns : subset nat s.
  apply Hmin.
  split.
    exact Hz.
    exact Hs.
apply extensionality.
intro x.
split.
  intro Hx.
  apply Hsub.
  exact Hx.
  intro Hx.
  apply Hns.
  exact Hx.
qed.
