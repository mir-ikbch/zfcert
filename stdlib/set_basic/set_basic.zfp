(* Basic Set Theory *)

choose empty Hempty from empty_set.

theorem empty_unique : forall a, forall b, ((forall z, not (z in a)) -> (forall z, not (z in b)) -> a = b).
intro a.
intro b.
intro H1.
intro H2.
apply extensionality.
intro z.
split.
intro Hz.
specialize H1 z as Hz1.
contradiction.
intro Hz.
specialize H2 z as Hz2.
contradiction.
qed.

alias subset x y := forall a, a in x -> a in y.

choose pair Hpair from pairing.

theorem exists_singleton : forall x, exists p, forall y, (y in p <-> y = x).
intro x.
specialize pairing x x as H.
resolution.
qed.

choose singleton Hsingleton from exists_singleton.


theorem exists_cup : forall x, forall y, exists u, forall z, (z in u <-> z in x or z in y).
intro x.
intro y.
specialize union pair(x,y) as H.
obtain u Hu from H.
use u.
intro z.
specialize Hu z as Huz.
cases Huz.
split.
  intro Hzinu.
  rule cut Hex : exists y', z in y' and y' in pair(x,y).
    apply Huz_forward.
    exact Hzinu.
  obtain y' Hy' from Hex.
  cases Hy'.
  rule cut Hy'eq : y' = x or y' = y.
    specialize Hpair x y y' as Hp.
    cases Hp.
    apply Hp_forward.
    exact Hy'_right.
  cases Hy'eq.
  left.
  rewrite <- Hy'eq_left.
  exact Hy'_left.
  right.
  rewrite <- Hy'eq_right.
  exact Hy'_left.
  intro Hor.
  cases Hor.
  apply Huz_backward.
  use x.
  split.
    exact Hor_left.
    specialize Hpair x y x as Hp.
    cases Hp.
    apply Hp_backward.
    left.
    refl.
    apply Huz_backward.
    use y.
    specialize Hpair x y y as Hp.
    cases Hp.
    split.
      exact Hor_right.
      apply Hp_backward.
      right.
      refl.
qed.

choose cup Hcup from exists_cup.

theorem eq_subst_mem : forall a, forall b, forall y, (a = b -> (y in a -> y in b)).
intro a.
intro b.
intro y.
intro Heq.
intro Hy.
rule equal_elim a b z : y in z.
exact Heq.
exact Hy.
qed.

theorem eq_sym : forall a, forall b, (a = b -> b = a).
intro a.
intro b.
intro Heq.
rule equal_elim a b z : z = a.
exact Heq.
refl.
qed.

theorem no_two_cycle : forall m, forall n, (m in n -> (n in m -> false)).
intro m.
intro n.
intro Hmn.
intro Hnm.
rule cut Hnonempty : exists a, a in pair(m,n).
  use m.
  specialize Hpair m n m as Hpmm.
  cases Hpmm.
  apply Hpmm_backward.
  left.
  refl.
specialize foundation pair(m,n) as Hf.
apply Hf in Hnonempty as Hy.
obtain y Hy2 from Hy.
cases Hy2.
specialize Hpair m n y as Hpy.
cases Hpy.
rule cut Hyeq : y = m or y = n.
  apply Hpy_forward.
  exact Hy2_left.
cases Hyeq.
  specialize eq_sym y m as Es1.
  apply Es1 in Hyeq_left as Hmy.
  specialize eq_subst_mem m y n as Esub1.
  rule cut Hniny : n in y.
    apply Esub1.
    exact Hmy.
    exact Hnm.
  specialize Hy2_right n as Hspec1.
  apply Hspec1.
  exact Hniny.
  specialize Hpair m n n as Hpnn.
  cases Hpnn.
  apply Hpnn_backward.
  right.
  refl.
  specialize eq_sym y n as Es2.
  apply Es2 in Hyeq_right as Hny.
  specialize eq_subst_mem n y m as Esub2.
  rule cut Hminy : m in y.
    apply Esub2.
    exact Hny.
    exact Hmn.
  specialize Hy2_right m as Hspec2.
  apply Hspec2.
  exact Hminy.
  specialize Hpair m n m as Hpmm2.
  cases Hpmm2.
  apply Hpmm2_backward.
  left.
  refl.
qed.

theorem eq_subst_mem_left : forall a, forall b, forall s, (a = b -> (a in s -> b in s)).
intro a.
intro b.
intro s.
intro Heq.
intro Ha.
rule equal_elim a b z : z in s.
exact Heq.
exact Ha.
qed.

theorem pair_eq : forall x1 y1 x2 y2, pair(x1,y1) = pair(x2,y2) ->
  (x1 = x2 and y1 = y2) or (x1 = y2 and y1 = x2).
intros.
rule cut H' : x1 in pair(x2,y2).
  rewrite <- H.
  apply <- Hpair.
  left.
  refl.
specialize Hpair x2 y2 x1 as Hp.
apply -> Hp in H' as Hp'.
cases Hp'.
  left.
  split.
    apply Hp'_left.

    rule cut Hy : y1 in pair(x2,y2).
      rewrite <- H.
      apply <- Hpair.
      right.
      refl.
    apply -> Hpair in Hy as Hy'.
    cases Hy'.
      rule cut Hy2 : y2 in pair(x1,y1).
        rewrite H.
        apply <- Hpair.
        right.
        refl.
      apply -> Hpair in Hy2 as Hy2'.
      cases Hy2'.
        rewrite Hy2'_left.
        rewrite Hy'_left.
        rewrite Hp'_left.
        refl.

        rewrite Hy2'_right.
        refl.
      apply Hy'_right.
  right.
  split.
    apply Hp'_right.

    rule cut Hy1 : y1 in pair(x2,y2).
      rewrite <- H.
      apply <- Hpair.
      right.
      refl.
    apply -> Hpair in Hy1 as Hy1'.
    cases Hy1'.
      apply Hy1'_left.

      rule cut Hx2 : x2 in pair(x1,y1).
        rewrite H.
        apply <- Hpair.
        left.
        refl.
      apply -> Hpair in Hx2 as Hx2'.
      cases Hx2'.
        rewrite Hx2'_left.
        rewrite Hy1'_right.
        rewrite Hp'_right.
        refl.

        rewrite Hx2'_right.
        refl.
qed.

definition opair(x,y) := pair(singleton(x), pair(x,y)).

(*
theorem opair_l_in : forall x y, x in opair(x,y).
intros.
specialize Hpair x pair(x,y) x as Hpx.
apply <- Hpx.
left.
refl.
qed.
*)

theorem singleton_inj : forall x y, singleton(x) = singleton(y) -> x = y.
intros.
rule cut Hx : x in singleton(y).
  rewrite <- H.
  specialize Hsingleton x as Hsx.
  apply <- Hsx.
  refl.
specialize Hsingleton y as Hsy.
apply -> Hsy in Hx as Hx'.
apply Hx'.
qed.

theorem singl_pair_eq : forall x y z, singleton(x) = pair(y,z) -> x = y and x = z.
intros.
split.
  rule cut H' : y in singleton(x).
    rewrite H.
    apply <- Hpair.
    left.
    refl.
  apply -> Hsingleton in H' as H''.
  rewrite H''.
  refl.

  rule cut H' : z in singleton(x).
    rewrite H.
    apply <- Hpair.
    right.
    refl.
  apply -> Hsingleton in H' as H''.
  rewrite H''.
  refl.
qed.

theorem opair_inj : forall x1 x2 y1 y2, opair(x1,y1) = opair(x2,y2) -> x1 = x2 and y1 = y2.
intros.
specialize pair_eq singleton(x1) pair(x1,y1) singleton(x2) pair(x2,y2) as Hp.
apply Hp in H as Hp'.
cases Hp'.
  cases Hp'_left.
  split.
    apply singleton_inj.
    apply Hp'_left_left.

    specialize pair_eq x1 y1 x2 y2 as Hp2.
    apply Hp2 in Hp'_left_right as Hp2'.
    cases Hp2'.
      cases Hp2'_left.
      apply Hp2'_left_right.

      cases Hp2'_right.
      rewrite <- Hp2'_right_left.
      rewrite Hp2'_right_right.
      apply singleton_inj.
      rewrite Hp'_left_left.
      refl.

  cases Hp'_right.
  specialize singl_pair_eq x1 x2 y2 as Hs.
  apply Hs in Hp'_right_left as He.
  cases He.
  split.
    apply He_left.

    rule cut Heq : singleton(x2) = pair(x1,y1).
      rewrite Hp'_right_right.
      refl.
    specialize singl_pair_eq x2 x1 y1 as Hs'.
    apply Hs' in Heq as He'.
    cases He'.
    rewrite <- He'_right.
    rewrite <- He_right.
    rewrite He_left.
    refl.
qed.

theorem product_exists :
  forall s1, forall s2, exists prod, forall x,
    x in prod <-> exists xl, exists xr, xl in s1 and xr in s2 and x = opair(xl,xr).
intros s1 s2.
specialize power_set cup(s1,s2) as Hpower.
obtain p Hp from Hpower.
specialize power_set p as Hpower2.
obtain bound Hbound from Hpower2.
separation Hprod bound x : exists xl, exists xr, xl in s1 and xr in s2 and x = opair(xl,xr).
obtain prod Hprod_mem from Hprod.
use prod.
intro x.
specialize Hprod_mem x as Hx.
split.
  intro Hxprod.
  apply -> Hx in Hxprod as Hparts.
  cases Hparts.
  exact Hparts_right.

  intro Hex.
  apply <- Hx.
  split.
    obtain xl Hxl from Hex.
    obtain xr Hxr from Hxl.
    cases Hxr.
    cases Hxr_left.
    rewrite Hxr_right.
    specialize Hbound opair(xl,xr) as Hop.
    apply <- Hop.
    intros z Hz.
    specialize Hpair singleton(xl) pair(xl,xr) z as Hzpair.
    apply -> Hzpair in Hz as Hzeq.
    cases Hzeq.
      rewrite Hzeq_left.
      specialize Hp singleton(xl) as Hsinglep.
      apply <- Hsinglep.
      intros w Hw.
      apply -> Hsingleton in Hw as Hweq.
      rewrite Hweq.
      apply <- Hcup.
      left.
      exact Hxr_left_left.

      rewrite Hzeq_right.
      specialize Hp pair(xl,xr) as Hpairp.
      apply <- Hpairp.
      intros w Hw.
      specialize Hpair xl xr w as Hwpair.
      apply -> Hwpair in Hw as Hweq.
      apply <- Hcup.
      cases Hweq.
        left.
        rewrite Hweq_left.
        exact Hxr_left_left.

        right.
        rewrite Hweq_right.
        exact Hxr_left_right.

    exact Hex.
qed.

choose prod Hprod from product_exists.

alias is_relation X Y R := subset R prod(X,Y).

alias is_function X Y f :=
      is_relation X Y f and
      (forall x, x in X -> exists y, opair(x,y) in f) and
      (forall x y1 y2, opair(x,y1) in f -> opair(x,y2) in f -> y1 = y2).

choose bigcup Hbigcup from union.

theorem bigcup_singleton' : forall X x, x in X -> (forall y, y in X -> x = y) ->
        bigcup(X) = x.
intros.
specialize extensionality bigcup(X) x as Hex.
apply Hex.
intros.
split.
  intros.
  specialize Hbigcup X z as Hz.
  apply -> Hz in H1 as Hz'.
  cases Hz' y Hy.
  cases Hy.
  specialize H0 y as H0y.
  apply H0y in Hy_right as Hy'.
  rewrite Hy'.
  apply Hy_left.
  intros.
  specialize Hbigcup X z as Hz.
  apply <- Hz.
  use x.
  resolution.
qed.

theorem bigcup_singleton : forall x, bigcup(singleton(x)) = x.
intros.
specialize extensionality bigcup(singleton(x)) x as Hex.
apply Hex.
intros.
split.
  intros.
  specialize Hbigcup singleton(x) as Hb.
  apply -> Hb in H as Hb'.
  cases Hb' y Hy.
  cases Hy.
  apply -> Hsingleton in Hy_right as Hsx.
  rewrite <- Hsx.
  apply Hy_left.

  intros.
  specialize Hbigcup singleton(x) as Hb.
  apply <- Hb.
  use x.
  split.
    apply H.
    apply <- Hsingleton.
    refl.
qed.
  
  
  

theorem image_exists : forall Y f x, exists I, forall y, y in I <-> y in Y and opair(x,y) in f.
intros.
separation Hsep Y y : opair(x,y) in f.
exact Hsep.
qed.

choose image Himage from image_exists.

theorem func_val_exists : forall X Y f x, is_function X Y f -> x in X ->
        exists y, y in image(Y,f,x).
intros.
cases H.
cases H_left.
specialize H_left_right x as Hx.
apply Hx in H0 as Hex.
cases Hex y Hy.
use y.
specialize Himage Y f x y as Him.
apply <- Him.
split.
  specialize H_left_left opair(x,y) as Hxy.
  apply Hxy in Hy as Hpr.
  specialize Hprod X Y opair(x,y) as Hpr'.
  apply -> Hpr' in Hpr as Hpr''.
  cases Hpr'' x' Hx'.
  cases Hx' y' Hy'.
  cases Hy'.
  cases Hy'_left.
  apply opair_inj in Hy'_right as Heq.
  cases Heq.
  rewrite Heq_right.
  apply Hy'_left_right.

  apply Hy.
qed.

theorem func_val_singleton : forall X Y f x, is_function X Y f -> x in X ->
        exists y, image(Y,f,x) = singleton(y).
intros.
rule cut Hyex : exists y, y in image(Y,f,x).
  specialize func_val_exists X Y f x as Hf.
  apply Hf.
  apply H.
  apply H0.
cases Hyex y Hy.
use y.
specialize extensionality image(Y,f,x) singleton(y) as Hext.
apply Hext.
intro.
split.
  intros.
  apply <- Hsingleton.
  cases H.
  specialize H_right x as Hx.
  apply Hx.
  apply -> Himage in H1 as H1'.
  resolution.
  apply -> Himage in Hy as Hy'.
  resolution.

  intros.
  apply <- Himage.
  apply -> Hsingleton in H1 as H1'.
  rewrite H1'.
  apply -> Himage in Hy as Hy'.
  resolution.
qed.

definition eval(Y,f,x) := bigcup( image(Y,f,x) ).

theorem eval_dom : forall X Y f x, x in X -> is_function X Y f -> eval(Y,f,x) in Y.
intros.
rule cut Hyex : exists y, image(Y,f,x) = singleton(y).
specialize func_val_singleton X Y f x as Hf.
apply Hf.
  resolution.
  resolution.
  cases Hyex y Hy.
  rewrite Hy.
  specialize bigcup_singleton y as Hb.
  rewrite Hb.
  rule cut Hyin : y in image(Y,f,x).
    rewrite Hy.
    apply <- Hsingleton.
    refl.
  apply -> Himage in Hyin as Hyin'.
  resolution.
qed.
